      "url": "/#lettersTab",
      "icon": "icon_2"
    }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "http://localhost:5000/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": {
      "enabled": false
